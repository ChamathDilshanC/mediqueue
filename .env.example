# For Vercel, replace this with Supabase Session Pooler (port 5432):
# postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./mediqueue.db
# Supabase project settings. Keep service-role keys and database passwords server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# For Supabase projects using asymmetric JWT signing:
SUPABASE_JWKS_URL=
AUTH_DEV_HEADER_ENABLED=false
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
DEV_BRANCH_ID=00000000-0000-0000-0000-000000000002
CONFIG_PATH=configuration/defaults.json
# Backend-only Stripe configuration. Never expose these in Next.js.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/patient?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/patient?payment=cancelled
# Platform operators (comma-separated, confirmed Supabase emails).
SYSTEM_ADMIN_EMAILS=
# compose.yaml: released image version and the public web origin.
MEDIQUEUE_VERSION=1.3.0
APP_ORIGIN=http://localhost:3000
